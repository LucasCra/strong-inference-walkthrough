                <mxCell id="k-lgt1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;align=left;fontSize=11;" value="gate" vertex="1"><mxGeometry x="1188" y="743" width="108" height="30" as="geometry"/></mxCell>
