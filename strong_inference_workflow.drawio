                    <mxGeometry height="110" width="140" x="240" y="665" as="geometry"/>
                </mxCell>
                <mxCell id="si-a" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;One:&lt;/b&gt; best of this family, not proven. It must pass its own risky test before it counts" vertex="1">
                    <mxGeometry height="80" width="170" x="240" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="si-b" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;Several, each partly right:&lt;/b&gt; measure each contribution" vertex="1">
                    <mxGeometry height="70" width="170" x="430" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="si-c" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;Several rivals, or undecided:&lt;/b&gt; new crucial experiment, more power, or sub-hypotheses" vertex="1">
                    <mxGeometry height="85" width="170" x="620" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="si-d" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;None:&lt;/b&gt; the family was incomplete, add new hypotheses" vertex="1">
                    <mxGeometry height="70" width="170" x="810" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="si-g9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="Objective met, budget spent, or objective wrong?" vertex="1">
                    <mxGeometry height="124" width="200" x="20" y="633" as="geometry"/>
                </mxCell>
                <mxCell id="si-end" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" value="&lt;b&gt;Stop&lt;/b&gt;: report exclusions, survivors, the tests they passed, what would still refute them, and every finding with its status. Every claim names its run; interpretation is marked as such" vertex="1">
                    <mxGeometry height="150" width="180" x="30" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="si-tree" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="&lt;b&gt;Logical tree + notebook&lt;/b&gt;&lt;br&gt;The accumulated knowledge&lt;br&gt;Node: question + live hypotheses&lt;br&gt;Edge: crucial experiment, the outcome picks the branch&lt;br&gt;Excluded hypotheses stay, with the run that excluded them&lt;br&gt;Untested hypotheses stay visible&lt;br&gt;Findings stay with a status: open, promoted, deferred or dropped, each with its reason&lt;br&gt;An exclusion holds under its conditions: if they change, reopen it as a finding&lt;br&gt;What holds becomes project knowledge, read by the next project" vertex="1">
                    <mxGeometry height="280" width="370" x="250" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="si-t1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;align=right;" value="No: fix the run or controls, no exclusion recorded. Blame only an auxiliary declared in step 6, never rescue ad hoc, and log the rescue and its cause: a hypothesis saved repeatedly is excluded" vertex="1">
                    <mxGeometry height="135" width="175" x="740" y="512" as="geometry"/>
                </mxCell>
                <mxCell id="si-t2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;align=left;" value="No: next sub-question, or a new puzzle from the data" vertex="1">
                    <mxGeometry height="46" width="145" x="25" y="292" as="geometry"/>
                </mxCell>
                <mxCell id="si-t3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#4d8a3d;" value="read at step 2" vertex="1">
                    <mxGeometry height="22" width="170" x="445" y="295" as="geometry"/>
                </mxCell>
                <mxCell id="si-t4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#4d8a3d;" value="write" vertex="1">
                    <mxGeometry height="20" width="40" x="500" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="bW4NQQmewjmJznq9_Is1-44" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;align=left;fontColor=#3a6ea5;" value="go back here when a finding shows a gap in knowledge" vertex="1">
                    <mxGeometry height="50" width="170" x="660" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="si-e20" edge="1" parent="1" source="si-tree" style="edgeStyle=none;html=1;rounded=0;endArrow=block;exitX=1;exitY=0.2857;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="bW4NQQmewjmJznq9_Is1-28" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="900" y="400"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="si-t5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#4d8a3d;" value="read at steps 3 and 4: findings" vertex="1">
                    <mxGeometry height="22" width="215" x="675" y="376" as="geometry"/>
                </mxCell>
                <mxCell id="si-8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;8. Analyze beyond the hypotheses&lt;/b&gt;&lt;br&gt;Same checks every run, whatever the hypothesis: errors by class and group, worst cases. Log what nobody predicted as a finding." vertex="1">
                    <mxGeometry height="140" width="190" x="610" y="650" as="geometry"/>
                </mxCell>
                <mxCell id="si-use" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;10. Use what was learned&lt;/b&gt;&lt;br&gt;What change does it justify? Not yet measured: predict it and run it through steps 5 to 9. Measured: store what holds, and under which conditions, as project knowledge" vertex="1">
                    <mxGeometry height="130" width="200" x="20" y="775" as="geometry"/>
                </mxCell>
                <mxCell id="si-e21" edge="1" parent="1" source="si-8" style="edgeStyle=none;html=1;rounded=0;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="bW4NQQmewjmJznq9_Is1-37" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="si-e22" edge="1" parent="1" source="si-use" style="edgeStyle=none;html=1;rounded=0;endArrow=block;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=12;" target="si-g9" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="si-e23" edge="1" parent="1" source="si-use" style="edgeStyle=none;html=1;rounded=0;endArrow=block;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;" target="si-5" value="">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="60" y="955"/>
                            <mxPoint x="1450" y="955"/>
                            <mxPoint x="1450" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="si-t6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#b85450;" value="Not yet measured: a new prediction and experiment" vertex="1">
                    <mxGeometry height="18" width="340" x="250" y="935" as="geometry"/>
                </mxCell>
                <mxCell id="si-t7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;" value="Measured" vertex="1">
                    <mxGeometry height="16" width="60" x="125" y="758" as="geometry"/>
                </mxCell>
                <mxCell id="si-e24" edge="1" parent="1" source="si-end" style="edgeStyle=none;html=1;rounded=0;endArrow=block;exitX=0.8333;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;strokeWidth=2;" target="bW4NQQmewjmJznq9_Is1-9" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="si-t8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#9673a6;" value="New or revised objective, starting from project knowledge" vertex="1">
                    <mxGeometry height="50" width="145" x="30" y="375" as="geometry"/>
                </mxCell>
                <mxCell id="si-popper" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;Popper, Conjectures and Refutations (1963)&lt;/b&gt;&lt;br&gt;Start from a problem, not from observations; hypotheses are bold guesses, not inductions from the review. A good hypothesis forbids outcomes; one that nothing could refute says nothing. Confirmations are easy to find and count only when they came from a risky prediction. Surviving a severe test corroborates, it never proves. Rescuing a refuted hypothesis ad hoc saves it at the cost of its scientific status." vertex="1">
                    <mxGeometry height="135" width="440" x="990" y="775" as="geometry"/>
                </mxCell>
                <mxCell id="bW4NQQmewjmJznq9_Is1-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=12;align=right;fontStyle=1;fontColor=#b85450;" value="Recycle this loop and create knowledge" vertex="1">
                    <mxGeometry height="24" width="260" x="1180" y="922" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>